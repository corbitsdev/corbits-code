#!/usr/bin/env bash
set -euo pipefail

PASS=0
FAIL=0

ok()   { echo "  ok   $*"; ((PASS++)) || true; }
fail() { echo "  FAIL $*"; ((FAIL++)) || true; }

echo "corbits: environment check"
echo ""

# Git hooks
echo "git hooks"
if git rev-parse --git-dir >/dev/null 2>&1; then
  hookspath=$(git config core.hooksPath 2>/dev/null || true)
  if [[ "$hookspath" == ".githooks" ]]; then
    if [[ -d ".githooks" ]]; then
      ok "core.hooksPath = .githooks"
    else
      fail ".githooks directory missing — run: mkdir .githooks"
    fi
  else
    fail "core.hooksPath not set to .githooks — run: git config core.hooksPath .githooks"
  fi
else
  fail "not inside a git repository"
fi
echo ""

# Bun
echo "bun"
if command -v bun >/dev/null 2>&1; then
  BUN_VERSION=$(bun --version)
  ok "bun $BUN_VERSION"
else
  fail "bun not found — install from https://bun.sh"
fi
echo ""

# interchange submodule
echo "interchange submodule"
if [[ -f "interchange/packages/agent/package.json" ]]; then
  ok "interchange submodule initialised"
else
  fail "interchange submodule missing — run: git submodule update --init --recursive"
fi
echo ""

# Provider settings — credentials come exclusively from the settings file;
# environment variables and .env files are not used.
echo "provider settings"
SETTINGS_FILE="${HOME}/.corbits/settings.json"
if [[ -f "$SETTINGS_FILE" ]]; then
  if grep -q '"providers"' "$SETTINGS_FILE"; then
    ok "$SETTINGS_FILE has a provider catalog"
  else
    fail "$SETTINGS_FILE has no \"providers\" — configure one or run onboarding"
  fi
else
  ok "$SETTINGS_FILE missing — onboarding will create it on first run"
fi
echo ""

# LSP (TypeScript/JavaScript in this repo)
echo "language server"
if [[ -x "node_modules/.bin/typescript-language-server" ]] || command -v typescript-language-server >/dev/null 2>&1; then
  ok "typescript-language-server available"
else
  fail "typescript-language-server missing — run: bun add -d typescript-language-server"
fi
echo ""

# Summary
if [[ $FAIL -eq 0 ]]; then
  echo "all checks passed"
  exit 0
else
  echo "$FAIL check(s) failed"
  exit 1
fi
