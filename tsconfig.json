{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@corbits/provider-opencode-go": ["./packages/opencode-go/src/index.ts"],
      "@corbits/first-class-providers": ["./packages/first-class-providers/src/index.ts"]
