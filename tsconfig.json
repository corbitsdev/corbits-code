{
  "extends": "./interchange/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": false,
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@intx/log": ["./interchange/packages/log/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
