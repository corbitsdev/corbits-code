{
  "name": "intercode",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "bin": {
    "intercode": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "test": "bun test ./src ./tests ./eval/lib",
    "test:tui": "bun test --isolate ./src/tui ./tests/unit/tui",
    "run": "bun run build && ./dist/index.js",
    "eval": "bun run scripts/eval.ts"
  },
  "workspaces": [
    ".",
    "./interchange/packages/agent",
    "./interchange/packages/inference",
    "./interchange/packages/inference-testing",
    "./interchange/packages/inference-discovery",
    "./interchange/packages/tools-posix",
    "./interchange/packages/types",
    "./interchange/packages/storage-isogit",
    "./interchange/packages/mime",
    "./interchange/packages/log",
    "./interchange/packages/crypto-node",
    "./interchange/packages/tools-lsp",
    "./packages/workflows",
    "./packages/agents",
    "./plugins/exa"
  ],
  "catalog": {
    "arktype": "^2.1.29"
  },
  "dependencies": {
    "@intercode/default-agents": "workspace:*",
    "@intercode/default-workflows": "workspace:*",
    "@intx/agent": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/log": "workspace:*",
    "@intx/storage-isogit": "workspace:*",
    "@intx/tools-lsp": "workspace:*",
    "@intx/tools-posix": "workspace:*",
    "@intx/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@intx/inference-testing": "workspace:*",
    "@types/bun": "1.3.9",
    "@types/react": "^19.2.15",
    "ink": "^7.0.4",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.6",
    "react-devtools-core": "^7.0.1",
    "typescript": "5.9.3",
    "ws": "^8.21.0"
  }
}
