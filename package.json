{
  "name": "@corbits/code",
  "version": "0.3.11",
  "description": "Single-process coding agent CLI built on the Interchange runtime (Bun + TypeScript)",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-code.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-code#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-code/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "bun",
    "typescript",
    "interchange",
    "mcp"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "bin": {
    "corbits": "./dist/corbits"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external '@opentui/core-*' && bun scripts/copy-repo-plugins.ts",
    "build:bin": "bun build ./src/index.ts --compile --minify --define process.env.NODE_ENV='\"production\"' --outfile ./dist/corbits && bun scripts/copy-repo-plugins.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/guard-real-projects-dir.ts ./src ./tests ./evals",
    "lint": "prettier --check --cache . && eslint --cache .",
    "check": "bun run lint && bun run typecheck && bun run build && bun run test",
    "start": "bun run build && bun ./dist/index.js",
    "eval:capability": "bun scripts/eval-capability.ts",
    "eval:public-swe-one": "bun scripts/eval-public-swe-one.ts",
    "tui:smoke": "bun ./src/tui/smoke.ts"
  },
  "workspaces": [
    ".",
    "./vendor/intx-inference",
    "./vendor/intx-types",
    "./vendor/intx-storage-isogit",
    "./packages/*"
  ],
  "overrides": {
    "@intx/inference": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/storage-isogit": "workspace:*"
  },
  "catalog": {
    "@types/semver": "^7.7.1",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1"
  },
  "dependencies": {
    "@intx/agent": "0.2.2",
    "@intx/authz": "0.2.2",
    "@intx/inference": "workspace:*",
    "@intx/log": "0.2.2",
    "@intx/storage-isogit": "workspace:*",
    "@intx/tools-lsp": "0.2.2",
    "@intx/tools-posix": "0.2.2",
    "@intx/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "0.5.1",
    "@opentui/keymap": "0.5.1",
    "@opentui/solid": "0.5.1",
    "arktype": "catalog:",
    "highlight.js": "^11.11.1",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@intx/inference-testing": "0.2.2",
    "@types/bun": "1.3.9",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.4",
    "typescript-language-server": "^4.3.4",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.5.1",
    "@opentui/core-darwin-x64": "0.5.1",
    "@opentui/core-linux-arm64": "0.5.1",
    "@opentui/core-linux-arm64-musl": "0.5.1",
    "@opentui/core-linux-x64": "0.5.1",
    "@opentui/core-linux-x64-musl": "0.5.1",
    "@opentui/core-win32-arm64": "0.5.1",
    "@opentui/core-win32-x64": "0.5.1"
  }
}
