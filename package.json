{
  "name": "@corbits/code",
  "version": "0.2.89",
  "description": "Single-process coding agent CLI built on the Interchange runtime (Bun + TypeScript)",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-code.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-code#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-code/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "bun",
    "typescript",
    "interchange",
    "mcp"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "bin": {
    "corbits": "./dist/corbits"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external react-devtools-core",
    "build:bin": "bun build ./src/index.ts --compile --minify --define process.env.NODE_ENV='\"production\"' --outfile ./dist/corbits",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./tests ./evals",
    "test:tui": "bun test --isolate --preload ./tests/setup/tui-preload.ts ./src/tui ./tests/unit/tui",
    "start": "bun run build && bun ./dist/index.js",
    "eval:capability": "bun scripts/eval-capability.ts"
  },
  "workspaces": [
    ".",
    "./vendor/intx-inference",
    "./packages/*"
  ],
  "overrides": {
    "@intx/inference": "workspace:*"
  },
  "catalog": {
    "@types/semver": "^7.7.1",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1"
  },
  "dependencies": {
    "@intx/agent": "0.2.2",
    "@intx/authz": "0.2.2",
    "@intx/inference": "workspace:*",
    "@intx/log": "0.2.2",
    "@intx/storage-isogit": "0.2.2",
    "@intx/tools-lsp": "0.2.2",
    "@intx/tools-posix": "0.2.2",
    "@intx/types": "0.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "arktype": "catalog:",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@intx/inference-testing": "0.2.2",
    "@types/bun": "1.3.9",
    "@types/react": "^19.2.15",
    "ink": "^7.0.4",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.6",
    "react-devtools-core": "^7.0.1",
    "typescript": "5.9.3",
    "typescript-language-server": "^4.3.4",
    "ws": "^8.21.0",
    "yoga-layout": "~3.2.1"
  }
}
